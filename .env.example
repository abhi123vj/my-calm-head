# MongoDB
# Connection string for the migraine tracker database.
# Local example:  mongodb://127.0.0.1:27017
# Atlas example:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DATABASE=migraine_tracker

# Application login (single user, server-side only)
APP_USERNAME=
APP_PASSWORD=

# Secret used to sign the session cookie.
# Generate one with:  openssl rand -base64 32
SESSION_SECRET=
